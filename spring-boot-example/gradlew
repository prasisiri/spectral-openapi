#!/bin/sh

# This is a simplified Gradle wrapper script - in a real project, you would generate this with 'gradle wrapper'

DEFAULT_JVM_OPTS=""

APP_BASE_NAME=$(basename "$0")
APP_HOME=$(dirname "$0")

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Use JAVA_HOME if set
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ] ; then
    echo "ERROR: JAVA_HOME is not set and 'java' command cannot be found."
    exit 1
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@" 